# Host ports of the local stack (docker-compose.yml). All are bound to 127.0.0.1 only.
# Copy to .env (git-ignored) and change a value to resolve a port conflict;
# the shell environment overrides .env. The start script prints the effective URLs.

# Gateway API and actuator (http://localhost:8080)
GATEWAY_PORT=8080

# Admin dashboard (http://localhost:3000)
DASHBOARD_PORT=3000

# Redis, for redis-cli or a gateway run from the IDE (localhost:6379)
REDIS_PORT=6379

# Quota settings passed to the gateway (see gateway/README.md, Configuration). The values shown
# are the defaults; invalid values stop the gateway at startup.
# Fixed-window period length in whole seconds, >= 1 (production: 86400).
QUOTA_PERIOD_SECONDS=60
# Requests per period for each tier, >= 1.
QUOTA_LIMIT_BRONZE=100
QUOTA_LIMIT_SILVER=1000
QUOTA_LIMIT_GOLD=10000
# A tenant is "near limit" from this percent of its limit, 1..99.
QUOTA_NEAR_THRESHOLD_PERCENT=80
