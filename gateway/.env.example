# Quota gateway configuration. Every variable is optional; the value shown is the default.

# HTTP port the gateway listens on (API and /actuator/health).
SERVER_PORT=8080

# Redis that holds the per-tenant usage counters, written asynchronously by one writer thread.
# The gateway starts and reports UP without Redis, and Redis is not part of health; while Redis is
# unreachable requests still succeed and their usage is not counted.
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
# Redis command and connect timeouts (Spring duration syntax, e.g. 500ms, 2s).
SPRING_DATA_REDIS_TIMEOUT=1s
SPRING_DATA_REDIS_CONNECT_TIMEOUT=1s

# Tenants file (JSON array of {id, name, tier}), read once at startup; relative to the working
# directory. Gradle bootRun/test use the repository's config/tenants.json, the Docker image
# /config/tenants.json. A missing or invalid file stops startup.
TENANTS_FILE=../config/tenants.json

# Quota settings. Invalid values stop startup.
# Fixed-window period length in whole seconds, >= 1 (production: 86400).
QUOTA_PERIOD_SECONDS=60
# Requests per period for each tier, >= 1.
QUOTA_LIMIT_BRONZE=100
QUOTA_LIMIT_SILVER=1000
QUOTA_LIMIT_GOLD=10000
# A tenant is "near limit" from this percent of its limit, 1..99.
QUOTA_NEAR_THRESHOLD_PERCENT=80

# Usage events waiting to be written to Redis, >= 1. When full, new events are dropped and
# counted; request threads never wait. Invalid values stop startup.
USAGE_QUEUE_CAPACITY=10000
