# Quota gateway configuration. Every variable is optional; the value shown is the default.

# HTTP port the gateway listens on (API and /actuator/health).
SERVER_PORT=8080

# Redis that will hold the per-tenant usage counters. Configured but not used yet: the gateway
# starts and reports UP without Redis, and Redis is not part of health.
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
