# Generator settings. Node does not load this file; set the variables in your shell, e.g.
#   GATEWAY_URL=http://localhost:9090 npm start
# Gateway base address (absolute http/https URL). Empty or unset = http://localhost:8080.
GATEWAY_URL=
# Shared tenants file. Empty or unset = ../config/tenants.json of this repository.
TENANTS_FILE=
# Traffic shape (rate, weights, in-flight limit, timeout). Empty or unset = traffic.json in this folder.
TRAFFIC_CONFIG_FILE=
